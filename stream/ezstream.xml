<?xml version="1.0" encoding="UTF-8"?>
<ezstream>
  <servers>
    <server>
      <hostname>localhost</hostname>
      <port>8000</port>
      <password>icecast</password>
      <protocol>HTTP</protocol>
      <user>source</user>
      <reconnect_attempts>20</reconnect_attempts>
    </server>
  </servers>

  <streams>
    <stream>
      <mountpoint>/stream</mountpoint>
      <format>MP3</format>
      <encoder>Lame-CBR128</encoder>
      <stream_name>Icecast Radio</stream_name>
      <stream_url>http://localhost:8000/stream</stream_url>
      <stream_genre>Various</stream_genre>
      <stream_description>Radio stream powered by Icecast + ezstream</stream_description>
      <stream_bitrate>128</stream_bitrate>
      <stream_samplerate>44100</stream_samplerate>
      <stream_channels>2</stream_channels>
      <public>No</public>
    </stream>
  </streams>

  <intakes>
    <intake>
      <name>default</name>
      <type>playlist</type>
      <filename>/var/www/html/icecast/playlists/playlist.m3u</filename>
      <shuffle>Yes</shuffle>
      <stream_once>No</stream_once>
    </intake>
  </intakes>

  <decoders>
    <decoder>
      <name>MadPlay</name>
      <program>madplay -b 16 -R 44100 -S -o raw:- @T@</program>
      <file_ext>.mp3</file_ext>
    </decoder>
    <decoder>
      <name>OggDec</name>
      <program>oggdec -R -b 16 -e 1 -s 1 -o - @T@</program>
      <file_ext>.ogg</file_ext>
      <file_ext>.oga</file_ext>
    </decoder>
    <decoder>
      <name>Flac</name>
      <program>flac -s -d --force-raw-format --sign=signed --endian=little -o - @T@</program>
      <file_ext>.flac</file_ext>
    </decoder>
  </decoders>

  <encoders>
    <encoder>
      <name>Lame-CBR128</name>
      <format>MP3</format>
      <program>lame --preset cbr 128 -r -s 44.1 --bitwidth 16 - -</program>
    </encoder>
  </encoders>

  <metadata>
    <format_str>@a@ - @t@</format_str>
    <refresh_interval>0</refresh_interval>
  </metadata>
</ezstream>
